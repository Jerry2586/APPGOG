# 复制为 .env 后再填写。不得提交 .env 或任何真实密钥。
APPGOG_WEB_PORT=8080
APPGOG_DOMAIN=www.example.com
APPGOG_DB_PASSWORD=
JWT_SECRET=
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=admin@appgog.local
ADMIN_DISPLAY_NAME=APPGOG 管理员
ADMIN_REFRESH_TTL_DAYS=7

# 正式域名；后台和官网同域时可填写相同 HTTPS Origin。
APP_ORIGIN=https://www.example.com
ADMIN_ORIGIN=https://www.example.com

# 仅允许无查询参数、无片段的普通页面 URL；APPGOG 不调用这些站点的 API。
XBOARD_LOGIN_URL=https://panel.example.com/login
XBOARD_REGISTER_URL=https://panel.example.com/register
XBOARD_PURCHASE_URL=https://panel.example.com/buy
XBOARD_DASHBOARD_URL=https://panel.example.com/dashboard
XBOARD_TICKET_URL=https://panel.example.com/ticket
XBOARD_AFFILIATE_URL=https://panel.example.com/affiliate

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EXTERNAL_ENABLED=false
AI_DAILY_MODEL_CALL_LIMIT=200
AI_WORKER_ENABLED=true
AI_TRUSTED_PROXY_IPS=
