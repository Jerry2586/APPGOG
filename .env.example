NODE_ENV=development
PORT=3000
# 本地 Docker PostgreSQL 密码；必须与下方 DATABASE_URL 中密码一致
APPGOG_DB_PASSWORD=
DATABASE_URL=postgresql://appgog:appgog@localhost:5432/appgog
REDIS_URL=redis://localhost:6379
# 至少 32 位随机值；禁止提交真实密钥
JWT_SECRET=
ADMIN_REFRESH_TTL_DAYS=7
APP_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@appgog.local
ADMIN_DISPLAY_NAME=APPGOG 管理员
# 首次初始化前必须填写至少 16 位随机密码；禁止提交真实密码
ADMIN_INITIAL_PASSWORD=
# 以下仅为浏览器普通跳转 URL，不得填写 Token、查询参数或 API 地址
XBOARD_LOGIN_URL=https://panel.domain.com/login
XBOARD_REGISTER_URL=https://panel.domain.com/register
XBOARD_PURCHASE_URL=https://panel.domain.com/buy
XBOARD_DASHBOARD_URL=https://panel.domain.com/dashboard
XBOARD_TICKET_URL=https://panel.domain.com/ticket
XBOARD_AFFILIATE_URL=https://panel.domain.com/affiliate
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 必须显式启用才会请求收费模型；只在服务端填写密钥，不得传给浏览器
AI_EXTERNAL_ENABLED=false
# 每 UTC 日模型 HTTP 请求上限（问答、检索向量和索引批次共用），不是货币预算
AI_DAILY_MODEL_CALL_LIMIT=200
AI_WORKER_ENABLED=true
# 仅列出直接连接 API 的可信反向代理 IP；空值忽略 X-Forwarded-For，防伪造限流来源
AI_TRUSTED_PROXY_IPS=
# APPGOG 私有媒体目录；不应由 Nginx 直接暴露，由 API 校验后读取
MEDIA_STORAGE_DIR=data/media
