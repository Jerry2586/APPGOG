{
  "name": "appgog",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "verify:boundaries": "node scripts/check-boundaries.mjs",
    "verify:database": "node scripts/check-database.mjs",
    "verify:security": "node scripts/check-security.mjs",
    "verify:pages": "node scripts/check-page-engine.mjs",
    "verify:components": "node scripts/check-components.mjs",
    "verify:media": "node scripts/check-media.mjs",
    "verify:cms": "node scripts/check-cms.mjs",
    "verify:catalog": "node scripts/check-catalog.mjs",
    "verify:ai": "node scripts/check-ai.mjs",
    "verify:operations": "node scripts/check-operations.mjs",
    "verify:site": "node scripts/check-site.mjs",
    "verify:xboard-theme": "node scripts/check-xboard-theme.mjs",
    "verify:deployment": "node scripts/check-deployment.mjs",
    "verify:performance": "node scripts/check-performance.mjs",
    "verify:acceptance": "node scripts/check-acceptance.mjs",
    "verify:installer": "node --test deploy/installer/server.spec.mjs && node scripts/check-installer.mjs && node scripts/check-one-click-installer.mjs",
    "verify": "pnpm db:generate && pnpm verify:boundaries && pnpm verify:database && pnpm verify:security && pnpm verify:pages && pnpm verify:components && pnpm verify:media && pnpm verify:cms && pnpm verify:catalog && pnpm verify:ai && pnpm verify:operations && pnpm verify:site && pnpm verify:xboard-theme && pnpm verify:deployment && pnpm verify:acceptance && pnpm verify:installer && pnpm lint && pnpm build && pnpm verify:performance && pnpm test",
    "db:generate": "pnpm --filter @appgog/api prisma:generate",
    "db:migrate": "pnpm --filter @appgog/api prisma:migrate",
    "db:deploy": "pnpm --filter @appgog/api prisma:migrate:deploy",
    "db:status": "pnpm --filter @appgog/api prisma:migrate:status",
    "db:seed": "pnpm --filter @appgog/api prisma:seed"
  }
}
